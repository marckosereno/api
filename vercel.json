{
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096"
    }
  },
  "functions": {
    "api/chat.cjs": {
      "runtime": "vercel/node@3.0.1",
      "memory": 256,
      "includeFiles":"data/progreso_data.json" 
      
    }
  },
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat.cjs"
    }
  ]
}
